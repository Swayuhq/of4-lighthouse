LIGHTHOUSE_DB_SOCKET=/var/run/postgresql/.s.PGSQL.5432
LIGHTHOUSE_DB_NAME=lighthouse
# The local socket: Postgres trusts your own Linux user, so no password is stored.
# The model agents. Without a key the keyword rules do the work alone. Run with `pnpm start:op` to read it from 1Password.
SWAYU_GEMINI_API_KEY=
SWAYU_LIGHTHOUSE_DAILY_CAP_USD=1
